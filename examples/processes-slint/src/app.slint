import { RouteTree } from "route-tree.slint";
import { RouteId } from "route-id.slint";
import { TabsModel } from "layouts/tabs.slint";
import { ProcessesModel } from "pages/processes.slint";
import { ServicesModel } from "pages/services.slint";
import { MetricsModel } from "pages/metrics.slint";

// Re-exported so Rust can reach them through the window: a global is only
// available on a component that (transitively) exports it.
export { TabsModel, ProcessesModel, ServicesModel, MetricsModel }

// The window is the application's; what it shows is generated from the routes!
// declaration, so the tree is written once and not twice.
export component AppWindow inherits Window {
    in property <RouteId> route;

    title: "guinea · processes (slint)";
    preferred-width: 640px;
    preferred-height: 480px;

    RouteTree {
        width: root.width;
        height: root.height;
        route: root.route;
    }
}
