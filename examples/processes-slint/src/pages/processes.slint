import { Button, ScrollView, HorizontalBox, VerticalBox } from "std-widgets.slint";

// The page's state and its actions, as a singleton beside the component that
// reads them. Rust binds to this once, when the router installs the page; the
// branch holding the component is created and destroyed as the route changes,
// and none of that touches what is bound here.
export global ProcessesModel {
    in property <[string]> items;
    callback kill(int);
}

// Named after the page in the route tree: that is how the generated tree
// knows which component draws it.
export component Processes {
    ScrollView {
        VerticalBox {
            alignment: start;
            for item[i] in ProcessesModel.items: HorizontalBox {
                Text {
                    text: item;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Kill";
                    clicked => {
                        ProcessesModel.kill(i);
                    }
                }
            }
        }
    }
}
