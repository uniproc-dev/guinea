import { VerticalBox, ProgressIndicator } from "std-widgets.slint";

export global MetricsModel {
    in property <float> cpu;
    in property <float> memory;
    in property <[float]> cpu-history;
}

export component Metrics {
    VerticalBox {
        Text {
            text: "CPU " + Math.round(MetricsModel.cpu) + "%";
            font-weight: 700;
        }
        ProgressIndicator {
            progress: MetricsModel.cpu / 100;
        }

        Text {
            text: "RAM " + Math.round(MetricsModel.memory) + "%";
            font-weight: 700;
        }
        ProgressIndicator {
            progress: MetricsModel.memory / 100;
        }

        // The same RingSeries the WinUI chart draws and the terminal turns
        // into a sparkline, as bars: one rectangle per sample.
        Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: 1px;
                alignment: end;
                for sample in MetricsModel.cpu-history: Rectangle {
                    width: 4px;
                    Rectangle {
                        y: parent.height - self.height;
                        height: parent.height * sample / 100;
                        background: #4a90d9;
                    }
                }
            }
        }
    }
}
