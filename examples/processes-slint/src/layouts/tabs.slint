import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { RouteId } from "route-id.slint";

export global TabsModel {
    in property <string> app-title;
    in property <string> status;
    in property <string> language-label;
    callback go(int);
    callback toggle-language();
}

export component TabsLayout {
    // Handed down by the generated tree, which knows this layout asked for it.
    in property <RouteId> route;

    VerticalBox {
        HorizontalBox {
            Text {
                text: TabsModel.app-title;
                font-weight: 700;
                vertical-alignment: center;
            }
            Button {
                text: "Processes";
                primary: root.route == RouteId.Processes;
                clicked => {
                    TabsModel.go(0);
                }
            }
            Button {
                text: "Services";
                primary: root.route == RouteId.Services;
                clicked => {
                    TabsModel.go(1);
                }
            }
            Button {
                text: "Metrics";
                primary: root.route == RouteId.Metrics;
                clicked => {
                    TabsModel.go(2);
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: TabsModel.language-label;
                clicked => {
                    TabsModel.toggle-language();
                }
            }
        }

        // The outlet, and the ordinary Slint one: whatever the root puts
        // inside this layout lands here. A layout and not a Rectangle, so the
        // page inside is stretched rather than left at its preferred size.
        VerticalLayout {
            vertical-stretch: 1;
            @children
        }

        Text {
            text: TabsModel.status;
        }
    }
}
